{
  "name": "autoapply",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @autoapply/web dev",
    "dev:api": "pnpm --filter @autoapply/api dev",
    "dev:worker": "pnpm --filter @autoapply/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @autoapply/web test:e2e",
    "db:generate": "pnpm --filter @autoapply/database generate",
    "db:migrate": "pnpm --filter @autoapply/database migrate:dev",
    "db:deploy": "pnpm --filter @autoapply/database migrate:deploy",
    "db:studio": "pnpm --filter @autoapply/database studio",
    "ops": "pnpm --silent --filter @autoapply/ops ops"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild", "sharp", "@tailwindcss/oxide", "unrs-resolver"]
  }
}
