{
  "name": "@autoapply/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./crypto": "./src/crypto.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "admin:grant": "tsx scripts/admin-role.ts grant",
    "admin:revoke": "tsx scripts/admin-role.ts revoke"
  },
  "dependencies": {
    "@autoapply/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
