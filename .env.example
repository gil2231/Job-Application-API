# PostgreSQL
DATABASE_URL="postgresql://autoapply:autoapply@localhost:5432/autoapply"
# Separate database used by integration tests (it is reset by the test run)
TEST_DATABASE_URL="postgresql://autoapply:autoapply@localhost:5432/autoapply_test"

# Redis (BullMQ queue + worker heartbeat)
REDIS_URL="redis://localhost:6379"

# 32-byte key, base64. Generate with: openssl rand -base64 32
# Encrypts sensitive fields at rest (demographic answers, browser session state).
DATA_ENCRYPTION_KEY=""

# Document storage: "local" (dev, writes to STORAGE_LOCAL_DIR) or "s3" (any S3-compatible service)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="autoapply-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Public URL of the web app (used for cookie security and absolute links)
APP_URL="http://localhost:3000"
# API server
API_PORT="4000"
# The API's address as the browser extension reaches it (shown in Settings → Browser extension)
API_PUBLIC_URL="http://localhost:4000"

# AI. AI_PROVIDER is "anthropic", "openai", or empty / "none" for the built-in
# tools, which need no key. Users can also pick a provider in Settings → AI;
# keys always stay on the server. AI_MODEL is optional and applies only to the
# AI_PROVIDER set here (blank uses that provider's default model).
AI_PROVIDER=""
AI_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Email and calendar sync (Integrations page). Leave empty to hide the Connect buttons.
# Redirect URIs to register: ${APP_URL}/api/integrations/google/callback and .../microsoft/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
# How often the worker syncs each connected account (0 turns it off)
MAIL_SYNC_INTERVAL_MS="600000"
# Testing only: point every Google / Microsoft endpoint at the mock (pnpm --filter @autoapply/inbox mock)
GOOGLE_ENDPOINT_BASE=""
MICROSOFT_ENDPOINT_BASE=""

# Browser worker (pnpm dev:worker)
WORKER_CONCURRENCY="2"
# "false" opens a visible browser so you can finish CAPTCHAs and sign-ins in it
WORKER_HEADLESS="true"
WORKER_INTERACTIVE_WAIT_MS="900000"
WORKER_LEASE_MS="90000"
WORKER_SCHEDULER_INTERVAL_MS="5000"
WORKER_NAVIGATION_TIMEOUT_MS="30000"
# Sites the worker may open. Only the local mock pages by default; real employer
# sites need AUTOMATION_ALLOW_ALL_HOSTS="true" (private addresses stay blocked).
AUTOMATION_ALLOWED_HOSTS="localhost,127.0.0.1"
AUTOMATION_ALLOW_ALL_HOSTS="false"
PLAYWRIGHT_CHROMIUM_EXECUTABLE=""

# Email: Needs Attention emails and daily job alerts (sent by the worker), and
# password resets and email confirmation (sent by the web app).
# "resend" sends through Resend (https://resend.com): set RESEND_API_KEY and an
# EMAIL_FROM address on a domain you verified there. "log" prints emails to the
# console. Left empty, emails are printed in development and not sent in production.
EMAIL_PROVIDER=""
RESEND_API_KEY=""
EMAIL_FROM="Applyance <alerts@yourdomain.com>"
# Set to "false" to stop this worker from sending alerts (for example on a second worker)
WORKER_NOTIFICATIONS="true"
WORKER_NOTIFIER_INTERVAL_MS="60000"
# Monitoring and backups (docs/operations/monitoring-and-backups.md). All optional; off when empty.
# Sentry or GlitchTip DSN for error reports from the web app, API and worker
ERROR_REPORTING_DSN=""
APP_ENV=""
# Optional Slack or Discord incoming webhook for backup alerts
ALERT_WEBHOOK_URL=""
# Nightly encrypted database backups (run by the worker; needs pg_dump/pg_restore).
# Generate the key with: pnpm ops generate-key. Keep a copy in your password manager.
BACKUP_ENCRYPTION_KEY=""
BACKUP_S3_BUCKET=""
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
# Or a local folder instead of a bucket, for development
BACKUP_LOCAL_DIR=""
# Empty scratch database the weekly restore test restores into (it is wiped each time)
BACKUP_VERIFY_DATABASE_URL=""
# Stripe billing. Leave STRIPE_SECRET_KEY empty to run without plans: every
# account then gets the paid plan's limits. Prices and limits shown in the app
# are in packages/shared/src/plans.ts; keep the Stripe prices in step.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
